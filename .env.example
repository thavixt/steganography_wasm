ENV=DEV

ADMINER_PORT=8080

FRONTEND_PORT=4124

POSTGRES_POST=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=database

SERVER_PORT=8000

WEBAUTHN_RP=localhost

# "http://localhost" for local dev (plain HTTP, no cert). Set to a real
# domain (e.g. wasm-steganography.komlosidev.net) in production - Caddy then
# provisions HTTPS automatically, no other config changes needed.
CADDY_SITE_ADDRESS=https://localhost
