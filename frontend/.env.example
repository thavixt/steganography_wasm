VITE_SERVER_URL=http://localhost:3000
VITE_WASM_REFRESH_INTERVAL=3000

# --- api/* Vercel functions (server-only - no VITE_ prefix, never exposed
# to the browser bundle) ---
# Local: postgres://admin:admin@localhost:5432/stego_wasm (docker-compose).
# Production: Supabase's transaction-pooler connection string (port 6543).
DATABASE_URL=
# Any string of 32+ characters - e.g. `openssl rand -base64 32`.
SESSION_SECRET=
# Bare domain (no scheme/port) the app is served from - "localhost" for
# local dev, the real domain in production.
WEBAUTHN_RP_ID=localhost
# The production origin (e.g. https://your-app.vercel.app) - leave unset for
# local dev, EXPECTED_ORIGINS already covers vercel dev's default origin.
PUBLIC_SITE_ORIGIN=