{
  "name": "steganography-wasm",
  "workspaces": [
    "frontend"
  ],
  "version": "1.0.0",
  "description": "Created with:",
  "homepage": "https://github.com/thavixt/stegangraphy_wasm#readme",
  "bugs": {
    "url": "https://github.com/thavixt/stegangraphy_wasm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thavixt/stegangraphy_wasm.git"
  },
  "license": "ISC",
  "author": "thavixt",
  "scripts": {
    "dev": "concurrently --names \"be,fe\" --prefix-colors \"green,blue\" \"npm run dev:be\" \"npm run dev:fe\"",
    "dev:be": "docker compose up -d postgres adminer",
    "dev:fe": "npm i && npm run dev:vercel --workspace=frontend",
    "reset:db": "docker compose stop postgres && rm -rf database/postgres/data && docker compose up -d postgres",
    "stop": "docker compose stop",
    "test": "node --test tests/encode-decode.test.js",
    "test:generate-images": "node tests/generate-test-images.js",
    "test:investigate:alpha": "node tests/investigate-alpha-region.js",
    "test:investigate:cross-carrier-text": "node tests/repro-cross-carrier-text.js"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "concurrently": "^9.2.1"
  },
  "devDependencies": {
    "pngjs": "^7.0.0"
  }
}
